# Public application configuration supplied by D; never add credentials or tokens.
EXPO_PUBLIC_STAGE=dev
# HTTPS HTTP API URL, without /v1.
EXPO_PUBLIC_API_BASE_URL=
# Cognito User Pool issuer, and its separate public mobile app client ID.
EXPO_PUBLIC_COGNITO_ISSUER=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_REDIRECT_URI=contextia-dev://auth/callback
