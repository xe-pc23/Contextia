{
  "name": "contextia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.3.0 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "pnpm -r build",
    "cdk:synth": "node --import tsx scripts/cdk.ts synth",
    "bootstrap:prepare:dev": "node --import tsx scripts/bootstrap.ts prepare dev",
    "bootstrap:dev": "node --import tsx scripts/bootstrap.ts apply dev",
    "aws:readiness:dev": "node --import tsx scripts/aws-readiness.ts dev",
    "cdk:diff:dev": "node --import tsx scripts/cdk.ts diff dev",
    "cdk:diff:prod": "node --import tsx scripts/cdk.ts diff prod",
    "deploy:dev": "node --import tsx scripts/cdk.ts deploy dev",
    "deploy:prod": "node --import tsx scripts/cdk.ts deploy prod",
    "smoke:dev": "node --import tsx scripts/smoke.ts dev",
    "smoke:prod": "node --import tsx scripts/smoke.ts prod",
    "dev:api": "pnpm --filter @contextia/api dev",
    "dev:web": "pnpm --filter @contextia/web dev",
    "dev:mobile": "pnpm --filter @contextia/mobile dev"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock": "3.1144.0",
    "@aws-sdk/client-cloudformation": "3.1144.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1144.0",
    "@aws-sdk/client-iam": "3.1144.0",
    "@aws-sdk/client-sts": "3.1144.0",
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "^24.0.0",
    "aws-cdk": "2.1143.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
